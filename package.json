{
  "name": "kudium-browser-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Kudium Browser and its Bun/Hono web service",
  "packageManager": "npm@12.2.0",
  "scripts": {
    "release:test": "node scripts/local-release.mjs test",
    "release:beta": "node scripts/local-release.mjs beta",
    "release:stable": "node scripts/local-release.mjs stable",
    "runtime:prepare": "node scripts/prepare-electron-runtime.mjs prepare",
    "runtime:sync": "node scripts/prepare-electron-runtime.mjs sync",
    "runtime:build": "node scripts/prepare-electron-runtime.mjs build",
    "runtime:verify": "node scripts/prepare-electron-runtime.mjs verify",
    "test:runtime": "node --test scripts/prepare-electron-runtime.test.mjs",
    "dev": "npm run dev:browser",
    "dev:browser": "npm --prefix apps/browser run dev --",
    "dev:web": "bun run --cwd apps/web dev",
    "build:browser": "npm --prefix apps/browser run build --",
    "package:browser": "npm --prefix apps/browser run package --",
    "package:web": "npm --prefix apps/browser run package:web --",
    "test": "npm run test:browser --",
    "test:browser": "npm --prefix apps/browser run test --",
    "test:browser:compatibility": "npm --prefix apps/browser run test:compatibility --",
    "test:browser:notes-editor": "npm --prefix apps/browser run test:notes-editor --",
    "test:web": "bun run --cwd apps/web test",
    "check:web": "bun run --cwd apps/web check",
    "db:generate": "bun run --cwd apps/web db:generate",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "install:browser": "npm --prefix apps/browser ci",
    "install:web": "bun install --cwd apps/web --frozen-lockfile",
    "start": "npm run dev:browser",
    "build": "npm run build:browser",
    "package": "npm run package:browser",
    "lint": "npm run lint:browser --",
    "lint:browser": "npm --prefix apps/browser run lint --",
    "test:packaged-security": "npm --prefix apps/browser run test:packaged-security --",
    "test:migrations": "npm --prefix apps/browser run test:migrations --",
    "test:migrations:native": "npm --prefix apps/browser run test:migrations:native --",
    "release:verify-migrations": "npm --prefix apps/browser run release:verify-migrations --",
    "storage:recovery": "npm --prefix apps/browser run storage:recovery --",
    "dummy": "npm --prefix apps/browser run dummy --",
    "showcase:refresh": "node scripts/refresh-showcase.mjs",
    "mailpit:up": "brew services start mailpit",
    "mailpit:down": "brew services stop mailpit",
    "mailpit:status": "brew services info mailpit"
  }
}
