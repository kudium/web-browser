{
  "name": "kudium-browser",
  "version": "1.0.0",
  "description": "A browser that brings your tabs, AI, project files and terminals into one focused workspace.",
  "keywords": [
    "social-media",
    "online",
    "chat",
    "web",
    "application",
    "singlebox",
    "browser",
    "multi-messenger",
    "multi-messenger",
    "day-to-day"
  ],
  "homepage": "https://kudium.com",
  "bugs": {
    "url": "https://github.com/kudium/web-browser/issues"
  },
  "browser": {
    "fs": true,
    "path": true,
    "os": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kudium/web-browser.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kudium",
    "email": "hello@kudium.com",
    "url": "https://kudium.com"
  },
  "contributors": [
    {
      "name": "Samson Oyetola",
      "email": "hello@samsonoyetola.com",
      "url": "https://github.com/samtax01"
    }
  ],
  "main": "./src/main/main.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true ts-node .erb/scripts/dev.ts",
    "build": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config .erb/configs/webpack.config.main.prod.ts --config .erb/configs/webpack.config.renderer.prod.ts",
    "start": "npm run dev",
    "package": "ts-node .erb/scripts/clean.js && npm run build && electron-builder build --publish never",
    "package:web": "ts-node .erb/scripts/clean.js && npm run build && electron-builder build --config .erb/configs/electron-builder.web.cjs --publish never",
    "test": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true ts-node .erb/scripts/checks.ts test",
    "test:packaged-security": "cross-env TS_NODE_TRANSPILE_ONLY=true ts-node .erb/scripts/checks.ts packaged-security",
    "test:compatibility": "node .erb/scripts/run-browser-compatibility.cjs",
    "test:sign-in": "node .erb/scripts/run-browser-signin.cjs",
    "test:notes-editor": "node .erb/scripts/run-notes-editor.cjs",
    "test:tab-switcher": "node .erb/scripts/run-tab-switcher.cjs",
    "test:chat-scroll": "node .erb/scripts/run-browser-ui-smoke.cjs --ai-chat-scroll-only",
    "test:space-footer": "node .erb/scripts/run-browser-ui-smoke.cjs --space-footer-only",
    "test:real-sites": "electron .erb/scripts/browser-ui-smoke.cjs --real-sites-only",
    "test:extension-side-panels": "node .erb/scripts/run-extension-side-panel-smoke.cjs",
    "test:muse-compatibility": "node .erb/scripts/run-extension-side-panel-smoke.cjs --muse",
    "test:task-manager": "electron .erb/scripts/browser-ui-smoke.cjs --task-manager-only",
    "test:kuditrust": "electron .erb/scripts/browser-ui-smoke.cjs --kuditrust-only",
    "lint": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true ts-node .erb/scripts/checks.ts lint",
    "postinstall": "node .erb/scripts/patch-native-messaging.cjs",
    "predev": "node .erb/scripts/patch-native-messaging.cjs && node .erb/scripts/build-password-auth.cjs && node .erb/scripts/build-apple-ai.cjs && node .erb/scripts/build-space-gestures.cjs && node .erb/scripts/brand-development-app.cjs && node .erb/scripts/build-hook-language.cjs",
    "prebuild": "node .erb/scripts/patch-native-messaging.cjs && node .erb/scripts/build-password-auth.cjs && node .erb/scripts/build-apple-ai.cjs && node .erb/scripts/build-space-gestures.cjs && node .erb/scripts/build-hook-language.cjs",
    "test:migrations": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true ts-node .erb/scripts/checks.ts storage-migration",
    "test:migrations:native": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true ts-node .erb/scripts/checks.ts storage-migration --native",
    "release:verify-migrations": "cross-env TS_NODE_TRANSPILE_ONLY=true ts-node .erb/scripts/storage-release-gate.ts",
    "storage:recovery": "cross-env TS_NODE_TRANSPILE_ONLY=true ts-node .erb/scripts/storage-recovery.ts",
    "test:space-gestures": "node .erb/scripts/build-space-gestures.cjs && electron .erb/scripts/space-gesture-smoke.cjs",
    "dummy": "node .erb/scripts/dummy.cjs"
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".eslintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "^yaml$": "<rootDir>/node_modules/yaml/dist/index.js",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "./.erb/scripts/test-setup.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      ".erb/dll",
      "<rootDir>/demo/"
    ],
    "transform": {
      "node_modules/(marked|lowlight|devlop|hast-util-to-text)/.*\\.js$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ],
      "node_modules/(react-arborist|react-dnd|react-dnd-html5-backend|dnd-core|@react-dnd)/.*\\.js$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ],
      "\\.(ts|tsx|js|jsx)$": "ts-jest",
      "\\.mjs$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!lowlight/|devlop/|hast-util-to-text/|@tiptap/markdown/|marked/|@toon-format/toon/|react-arborist/|react-dnd/|react-dnd-html5-backend/|dnd-core/|@react-dnd/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/release/app/package.json"
    ]
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@ghostery/adblocker": "^2.20.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/themes": "^3.3.0",
    "@tiptap/extension-code-block-lowlight": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@toon-format/toon": "^4.4.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.19.0",
    "dompurify": "^3.4.18",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "image-size": "2.1.0",
    "jju": "^1.4.0",
    "json5": "^2.2.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.73.0",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.5.33",
    "posthog-node": "^5.73.1",
    "react": "^19.3.1",
    "react-arborist": "4.0.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.23.0",
    "react-router-dom": "^7.18.5",
    "smol-toml": "^1.9.1",
    "tldts": "^7.5.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.14",
    "@electron/notarize": "^3.1.2",
    "@electron/rebuild": "^4.2.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@svgr/webpack": "^8.1.0",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "babel-jest": "^30.5.2",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "^6.0.1",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electronmon": "^2.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.10.1",
    "prettier-plugin-jsdoc": "^1.8.1",
    "react-refresh": "^0.19.0",
    "react-refresh-typescript": "^2.0.12",
    "react-test-renderer": "^19.3.1",
    "rimraf": "^6.1.4",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1",
    "webpack-subresource-integrity": "^5.1.0"
  },
  "build": {
    "productName": "Kudium Browser",
    "appId": "com.kudium.kudiumbrowser",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "asarUnpack": [
      "**\\*.{node,dll}",
      "node_modules/node-pty/**"
    ],
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterPack": ".erb/scripts/check-packaged-dependencies.cjs",
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSCameraUsageDescription": "Kudium lets websites use your camera only after you allow access.",
        "NSMicrophoneUsageDescription": "Kudium lets websites use your microphone only after you allow access."
      },
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "assets/app-icon.png"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**",
      {
        "from": "mcp",
        "to": "mcp"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "samtax01",
      "repo": "KudiumBrowser"
    },
    "copyright": "Copyright © 2026 Kudium",
    "protocols": [
      {
        "name": "Web pages",
        "schemes": [
          "http",
          "https"
        ]
      },
      {
        "name": "Kudium hook installation",
        "schemes": [
          "kudium"
        ]
      }
    ]
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.2.0"
  },
  "electronmon": {
    "patterns": [
      ".erb/dll/main.js",
      ".erb/dll/preload.js"
    ],
    "logLevel": "quiet"
  },
  "packageManager": "npm@12.2.0",
  "overrides": {
    "adm-zip": "0.6.1",
    "minimatch@>=7 <11.0.1": "^11.0.8"
  }
}
