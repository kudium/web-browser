DATABASE_URL=postgres://localhost:5432/kudium
PORT=3000
# Generate once with: openssl rand -base64 48
# Keep the same secret across deployments and replicas.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://browser.kudium.com
# Local development only: BETTER_AUTH_URL=http://localhost:3000
# Optional SMTP: configure both to enable verification and password recovery.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=Kudium <hello@kudium.com>
# Local Mailpit alternative (no credentials, mail stays on your Mac):
# SMTP_URL=smtp://127.0.0.1:1025
# SMTP_FROM=Kudium Local <hello@kudium.local>
# Only these exact HTTPS origins may host release downloads (comma separated).
RELEASE_ASSET_ORIGINS=https://github.com,https://browser.kudium.com

# CI installer publication; both settings are required to enable uploads.
RELEASE_STORAGE_PATH=/app/release-assets
# Generate with: openssl rand -hex 48; also store as a GitHub Actions secret.
RELEASE_PUBLISH_TOKEN=

# Enables account-managed sync and dashboard data access. Generate once with
# a cryptographically random 32-byte base64url value; retain it in server secrets.
# Back up this key independently of account passwords. Do not rotate without
# re-wrapping account keys, and never commit a real value here.
SYNC_MASTER_KEY=

# Google Auth Platform web client; callback is /api/auth/callback/google.
# Keep the client secret in server runtime secrets only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
